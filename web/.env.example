# Neon Auth (provisioned on the project's neondb database)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Server-only connection to bahkam_honey using role ibex_app_runtime.
# Never expose this value to browser code.
IBEX_DATABASE_URL=

# Server-only Gemini API configuration via Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
